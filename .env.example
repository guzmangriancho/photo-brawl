# FRONTEND: para modo local (npm run dev:online) no hace falta configurar nada.
# Publicado en Vercel HTTPS: URL segura del servidor autoritativo separado.
# VITE_ONLINE_WS_URL=wss://online.tudominio.com/ws

# SERVIDOR Node.js: limitar origen cuando se publique, por ejemplo:
# ONLINE_ALLOWED_ORIGINS=https://photo-brawl.vercel.app
# ONLINE_PORT=8787
# ONLINE_RECONNECT_GRACE_MS=90000
